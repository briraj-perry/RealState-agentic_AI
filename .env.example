# Copy to .env. Never commit credentials.
ADMIN_API_KEY=replace-with-a-long-random-secret
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=estate_ai
BUSINESS_NAME=Estate AI Realty
# Demonstration listings are NEVER loaded automatically.
ALLOW_DEMO_DATA=false

# Local Ollama handles cloud authentication using your signed-in account.
OLLAMA_BASE_URL=http://localhost:11434
# Optional for localhost; required for direct https://ollama.com access.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud

# Start in simulation mode; switch only after completing docs/WHATSAPP_SETUP.md.
WHATSAPP_MODE=simulate
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Set a supported Graph API version from your Meta dashboard, e.g. v26.0.
WHATSAPP_GRAPH_VERSION=

# One embedded worker / one API process for this first release.
WORKER_ENABLED=true
